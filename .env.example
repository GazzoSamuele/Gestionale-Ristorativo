# Copia questo file in .env e riempi il valore.
# In produzione la variabile va impostata dal pannello di Vercel,
# non da un file: su Vercel il filesystem del build e' effimero.

# Postgres. In locale:
#   postgresql://postgres:password@localhost:5432/gestionale_ristorativo?schema=public
#
# In produzione usa la connection string CON POOLER del provider
# (Neon: l'host che contiene "-pooler"; Supabase: la porta 6543).
# Ogni funzione serverless apre le sue connessioni: con la stringa
# diretta il pool di Postgres si satura al primo picco di traffico.
DATABASE_URL="postgresql://utente:password@host:5432/database?schema=public"
